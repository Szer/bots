<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <GenerateProgramFile>false</GenerateProgramFile>
    <!-- Custom entry point in Program.fs adds `login` / `list-dialogs` console modes. -->
    <XunitAutoGeneratedEntryPoint>false</XunitAutoGeneratedEntryPoint>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="RealEnv.fs" />
    <Compile Include="TgUserClient.fs" />
    <Compile Include="TestRetry.fs" />
    <Compile Include="DbSeed.fs" />
    <Compile Include="RealAssemblyFixture.fs" />
    <!-- Declared FIRST among the test files: MembershipGateRealTests MUST run in
         isolation, before anything else populates TelegramMembershipService's 1-day
         cache for this suite's single test account — see its doc comment. File order
         is not a guarantee of xUnit execution order (same caveat AlitaBot.RealTests'
         .fsproj notes for NlToolLoopRealTests); the real enforcement is that this
         class is excluded from the default suite run (see the
         coupon-real-test-membership Makefile target) and run alone. -->
    <Compile Include="MembershipGateRealTests.fs" />
    <Compile Include="SmokeTests.fs" />
    <Compile Include="AddFlowRealTests.fs" />
    <Compile Include="BulkAddRealTests.fs" />
    <Compile Include="CouponLifecycleRealTests.fs" />
    <Compile Include="ReportFlowRealTests.fs" />
    <Compile Include="ReminderRealTests.fs" />
    <!-- CompileAfter guarantees the [<EntryPoint>] file lands after build-injected
         sources (xunit runner reporters, MTP SelfRegisteredExtensions). -->
    <CompileAfter Include="Program.fs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Dapper" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="Npgsql" />
    <PackageReference Include="WTelegramClient" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <!-- No ProjectReference to src/CouponHubBot: unlike AlitaBot.RealTests (which spawns
       the bot as a local child process and needs it built first), this suite always
       talks to an externally-running bot at COUPON_BOT_BASE_URL — the CI AKS pod or a
       developer's own local container/ngrok setup — never a process this harness
       starts itself (see RealEnv.fs's and RealAssemblyFixture.fs's doc comments). -->

</Project>
